# Шаблон переменных окружения. Скопируйте в .env и заполните.
#     cp .env.example .env
#
# В этом файле нет рабочих значений намеренно: токен и никнейм бота
# выдаются в консоли MAX, и в репозитории им не место.

# ---------------------------------------------------------------------------
# Обязательное. Бот не запустится без этих двух значений.
# ---------------------------------------------------------------------------

# Токен бота из консоли разработчика MAX: https://dev.max.ru
# Длинная буквенно-цифровая строка, выдаётся при создании бота.
MAX_BOT_TOKEN=

# Никнейм бота без символа @. Из него бот собирает ссылки для клиентов:
#     https://max.ru/<BOT_USERNAME>?start=s_<slug>
# Узнать можно так же, как токен: консоль MAX или ответ на getMe.
BOT_USERNAME=

# ---------------------------------------------------------------------------
# Необязательное. Значения ниже — действующие по умолчанию.
# ---------------------------------------------------------------------------

# Часовой пояс новых подботов. Каждый подбот потом меняет свой отдельно.
DEFAULT_TIMEZONE=Europe/Moscow

# Лимиты мультиарендности. Регистрации нет, поэтому панель доступна
# каждому, кто открыл бота, а лимиты ограничивают число подботов.
MAX_SUBBOTS_PER_USER=5
MAX_SUBBOTS_PER_DAY=10

# Ограничение отправки, запросов в секунду. У MAX лимит 30 на бота;
# запас оставлен на ретраи.
API_RATE_LIMIT=25

# Как часто планировщик проверяет очередь фоновых задач, секунды.
JOBS_POLL_INTERVAL=15

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Файл SQLite. В контейнере compose переопределяет на /app/data/bot.db,
# в docker-compose.yml этот путь смонтирован на именованный том.
DATABASE_PATH=data/bot.db
